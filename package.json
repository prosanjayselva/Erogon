{
  "name": "ergon-foundation-platform",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "client/portfolio",
    "client/admin-panel",
    "server"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "npm run dev --workspace ergon-foundation",
    "dev:admin": "npm run dev --workspace ergon-admin-panel",
    "dev:api": "npm run dev --workspace ergon-server",
    "build": "turbo build",
    "build:web": "npm run build --workspace ergon-foundation",
    "build:admin": "npm run build --workspace ergon-admin-panel"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "turbo": "^2.10.5"
  }
}
