{
  "name": "ERGON Foundation — Full Design System",
  "tagline": "Rooted in Good Deeds — People · Pets · Planet",
  "version": "1.0.0",
  "modules": ["public-site", "admin-panel"],

  "colors": {
    "public": {
      "forest": {
        "950": "#0e1c08",
        "900": "#142c0c",
        "800": "#1c3b12",
        "700": "#234a17",
        "600": "#2f5b1c",
        "500": "#3d7025",
        "400": "#5b8a3a",
        "300": "#86ab68",
        "100": "#dde8cf"
      },
      "gold": {
        "700": "#966d1f",
        "600": "#b98a2e",
        "500": "#d3a13f",
        "300": "#e7c672",
        "100": "#f5e8c8"
      },
      "clay": { "500": "#b5602f" },
      "cream": {
        "50": "#fbf8f1",
        "100": "#f4eee0",
        "200": "#ece2cc"
      },
      "paper": "#fffdf9",
      "ink": {
        "900": "#1a1d14",
        "700": "#3a3f31",
        "500": "#63684f",
        "300": "#9ba088"
      },
      "line": "rgba(28, 59, 18, 0.14)"
    },
    "admin": {
      "primary": {
        "DEFAULT": "#2E7D32",
        "dark": "#1B5E20",
        "light": "#4CAF50",
        "bg": "#E8F5E9"
      },
      "secondary": "#F5F8F2",
      "background": "#FAFBF8",
      "surface": "#FFFFFF",
      "border": "#E5E7EB",
      "text": "#111827",
      "muted": "#6B7280",
      "success": "#22C55E",
      "warning": "#F59E0B",
      "danger": "#EF4444",
      "payment": {
        "upi": { "bg": "#DCFCE7", "text": "#166534" },
        "card": { "bg": "#DBEAFE", "text": "#1E40AF" },
        "net": { "bg": "#F3E8FF", "text": "#6B21A8" }
      },
      "status": {
        "upcoming": { "bg": "#DCFCE7", "text": "#166534" },
        "completed": { "bg": "#F3E8FF", "text": "#6B21A8" },
        "cancelled": { "bg": "#FEF2F2", "text": "#991B1B" }
      }
    }
  },

  "typography": {
    "public": {
      "fontFamily": {
        "display": "Fraunces, Iowan Old Style, Georgia, serif",
        "body": "Work Sans, -apple-system, BlinkMacSystemFont, sans-serif"
      },
      "heading": {
        "h1": { "size": "clamp(2.7rem, 6vw, 4.6rem)", "weight": 600, "letterSpacing": "-0.01em", "lineHeight": 1.05 },
        "h2": { "size": "clamp(1.8rem, 4vw, 2.8rem)", "weight": 600, "letterSpacing": "-0.01em", "lineHeight": 1.15 },
        "h3": { "size": "clamp(1.3rem, 2.5vw, 1.7rem)", "weight": 600, "letterSpacing": "-0.01em", "lineHeight": 1.2 },
        "h4": { "size": "1.1rem", "weight": 600, "letterSpacing": "-0.01em", "lineHeight": 1.25 }
      },
      "body": {
        "base": { "size": "1rem", "lineHeight": 1.7 },
        "lede": { "size": "1.08rem", "lineHeight": 1.75 },
        "small": { "size": "0.88rem", "lineHeight": 1.6 },
        "xs": { "size": "0.8rem", "lineHeight": 1.5 }
      },
      "label": {
        "eyebrow": { "size": "0.72rem", "weight": 700, "letterSpacing": "0.14em", "uppercase": true },
        "pill": { "size": "0.72rem", "weight": 600, "letterSpacing": "0.06em", "uppercase": true }
      }
    },
    "admin": {
      "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif",
      "heading": {
        "pageTitle": { "size": "22px", "weight": 700 },
        "panelTitle": { "size": "16px", "weight": 700 },
        "formTitle": { "size": "18px", "weight": 700 },
        "loginTitle": { "size": "28px", "weight": 800, "letterSpacing": "1px" }
      },
      "body": {
        "base": { "size": "14px", "lineHeight": 1.5 },
        "stat": { "size": "28px", "weight": 800 },
        "small": { "size": "13px" },
        "xs": { "size": "12px" },
        "tagline": { "size": "11px", "letterSpacing": "0.5px", "style": "italic" }
      },
      "label": {
        "sidebar": { "size": "14px", "weight": 500 },
        "tableHeader": { "size": "12px", "weight": 600, "uppercase": true, "letterSpacing": "0.5px" },
        "badge": { "size": "12px", "weight": 500 },
        "statusBadge": { "size": "11px", "weight": 600, "uppercase": true }
      }
    }
  },

  "layout": {
    "public": {
      "maxWidth": "1240px",
      "padding": "clamp(20px, 5vw, 64px)",
      "sectionGap": "clamp(48px, 8vw, 96px)",
      "grid": {
        "columns2": "repeat(2, 1fr)",
        "columns3": "repeat(3, 1fr)",
        "columns4": "repeat(4, 1fr)",
        "columns6": "repeat(6, 1fr)",
        "gap": "28px",
        "gapLarge": "40px"
      },
      "breakpoints": {
        "mobile": "560px",
        "tablet": "768px",
        "desktop": "980px",
        "wide": "1100px"
      }
    },
    "admin": {
      "sidebarWidth": "260px",
      "headerHeight": "80px",
      "contentPadding": "24px 32px",
      "breakpoints": {
        "statCards": "1200px",
        "statCardsSingle": "640px",
        "panels": "768px"
      }
    }
  },

  "radius": {
    "public": {
      "sm": "10px",
      "md": "18px",
      "lg": "32px",
      "pill": "999px",
      "blob": "42% 58% 63% 37% / 41% 44% 56% 59%"
    },
    "admin": {
      "sm": "8px",
      "md": "10px",
      "lg": "14px",
      "xl": "16px"
    }
  },

  "motion": {
    "easing": {
      "organic": "cubic-bezier(0.22, 1, 0.36, 1)",
      "soft": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "duration": {
      "fast": "0.15s",
      "base": "0.35s",
      "slow": "0.5s"
    }
  },

  "components": {
    "public": {
      "header": {
        "background": "rgba(251, 248, 241, 0.92)",
        "backdropFilter": "blur(16px) saturate(1.3)",
        "logoHeight": "68px",
        "position": "sticky",
        "zIndex": 100
      },
      "nav": {
        "linkSize": "0.82rem",
        "linkWeight": 500,
        "linkColor": "ink.500",
        "hoverColor": "forest.800",
        "activeColor": "forest.900",
        "activeWeight": 600,
        "underlineColor": "gold.600",
        "gap": "6px",
        "itemPadding": "12px 14px"
      },
      "button": {
        "primary": {
          "background": "gold.600",
          "color": "forest.950",
          "radius": "pill",
          "padding": "12px 26px",
          "fontSize": "0.88rem",
          "fontWeight": 700,
          "hoverBackground": "gold.500"
        },
        "ghost": {
          "background": "transparent",
          "border": "1.5px solid line",
          "color": "forest.800",
          "radius": "pill",
          "padding": "11px 24px",
          "fontSize": "0.88rem",
          "fontWeight": 600,
          "hoverBackground": "cream.100"
        },
        "gold": {
          "background": "gold.500",
          "color": "forest.950",
          "radius": "pill",
          "padding": "14px 32px",
          "fontSize": "1rem",
          "fontWeight": 700
        },
        "sm": { "padding": "9px 20px", "fontSize": "0.82rem" }
      },
      "card": {
        "background": "paper",
        "border": "1px solid line",
        "borderRadius": "md",
        "padding": "28px",
        "shadow": "0 2px 12px rgba(14, 28, 8, 0.06)",
        "hoverShadow": "0 8px 28px rgba(14, 28, 8, 0.1)",
        "hoverTranslate": "translateY(-4px)"
      },
      "photoFrame": {
        "borderRadius": "lg",
        "overflow": "hidden",
        "aspectRatio": "4/3",
        "placeholderGradient": "linear-gradient(135deg, forest.100, cream.200)"
      },
      "hero": {
        "background": "cream.50",
        "padding": "clamp(40px, 6vw, 76px) clamp(64px, 8vw, 96px)"
      },
      "heroGrid": {
        "columns": "1.05fr 0.95fr",
        "gap": "clamp(30px, 5vw, 70px)"
      },
      "statStrip": {
        "background": "forest.800",
        "borderRadius": "lg",
        "color": "cream.50",
        "dividerColor": "rgba(251,248,241,0.15)"
      },
      "impactBand": {
        "background": "forest.900",
        "borderRadius": "lg",
        "color": "cream.50",
        "padding": "clamp(32px, 4vw, 52px)"
      },
      "ctaBanner": {
        "background": "forest.800",
        "borderRadius": "lg",
        "color": "cream.50",
        "padding": "clamp(36px, 5vw, 60px)",
        "textAlign": "center"
      },
      "pageHero": {
        "background": "forest.900",
        "color": "cream.50",
        "padding": "clamp(72px, 12vw, 140px) 0 clamp(40px, 6vw, 64px)"
      },
      "footer": {
        "background": "forest.950",
        "color": "rgba(251,248,241,0.78)",
        "logoHeight": "56px",
        "gridColumns": "1.4fr 1fr 1fr 1.1fr"
      },
      "form": {
        "input": {
          "border": "1.5px solid line",
          "borderRadius": "sm",
          "padding": "12px 16px",
          "fontSize": "0.92rem",
          "focusBorder": "gold.500",
          "focusShadow": "0 0 0 3px rgba(211,161,63,0.15)"
        },
        "textarea": { "minHeight": "110px", "resize": "vertical" }
      },
      "tabBar": {
        "background": "cream.100",
        "borderRadius": "pill",
        "activeBackground": "forest.800",
        "activeColor": "cream.50",
        "padding": "4px"
      },
      "progressBar": {
        "height": "7px",
        "background": "cream.200",
        "barColor": "gold.500",
        "borderRadius": "pill"
      },
      "timeline": {
        "dotColor": "gold.500",
        "lineColor": "line",
        "yearColor": "gold.600"
      },
      "iconBadge": {
        "size": "52px",
        "borderRadius": "50%",
        "background": "cream.100",
        "color": "forest.700"
      },
      "quoteCard": {
        "borderLeft": "3px solid gold.500",
        "fontStyle": "italic",
        "fontFamily": "display"
      },
      "partner": {
        "background": "cream.100",
        "borderRadius": "pill",
        "padding": "10px 22px",
        "fontSize": "0.82rem",
        "fontWeight": 600
      }
    },
    "admin": {
      "sidebar": {
        "width": "260px",
        "background": "surface",
        "borderRight": "1px solid border",
        "logoSize": "44px",
        "logoRadius": "10px",
        "linkPadding": "11px 14px",
        "linkRadius": "10px",
        "linkFontSize": "14px",
        "activeBg": "primary",
        "activeColor": "#fff"
      },
      "header": {
        "height": "80px",
        "background": "surface",
        "borderBottom": "1px solid border",
        "padding": "0 32px",
        "position": "sticky",
        "zIndex": 40
      },
      "statCard": {
        "background": "surface",
        "border": "1px solid border",
        "borderRadius": "14px",
        "padding": "20px 22px",
        "iconSize": "40px",
        "iconRadius": "10px",
        "valueSize": "28px",
        "hoverShadow": "0 4px 16px rgba(0,0,0,0.06)"
      },
      "table": {
        "background": "surface",
        "border": "1px solid border",
        "borderRadius": "14px",
        "headerBg": "secondary",
        "headerSize": "12px",
        "cellPadding": "14px 18px",
        "cellFontSize": "14px",
        "hoverBg": "#F9FAFB"
      },
      "loginPage": {
        "background": "linear-gradient(135deg, #1B5E20 0%, #2E7D32 50%, #4CAF50 100%)",
        "formBg": "surface",
        "formPadding": "48px 40px",
        "formRadius": "16px",
        "formWidth": "420px",
        "formShadow": "0 20px 60px rgba(0,0,0,0.15)"
      },
      "eventCard": {
        "background": "surface",
        "border": "1px solid border",
        "borderRadius": "14px",
        "imageHeight": "160px",
        "hoverShadow": "0 4px 16px rgba(0,0,0,0.06)"
      },
      "form": {
        "background": "surface",
        "border": "1px solid border",
        "borderRadius": "14px",
        "padding": "24px",
        "inputPadding": "10px 14px",
        "inputRadius": "10px",
        "inputFontSize": "14px",
        "focusBorder": "primary",
        "focusShadow": "0 0 0 3px rgba(46,125,50,0.1)"
      },
      "button": {
        "add": {
          "background": "primary",
          "color": "#fff",
          "radius": "10px",
          "padding": "10px 20px",
          "fontSize": "14px",
          "fontWeight": 600
        },
        "save": {
          "background": "primary",
          "color": "#fff",
          "radius": "10px",
          "padding": "10px 24px",
          "fontSize": "14px",
          "fontWeight": 600
        },
        "logout": {
          "background": "transparent",
          "color": "danger",
          "border": "1px solid #FECACA",
          "radius": "8px",
          "padding": "8px 18px",
          "fontSize": "13px"
        },
        "icon": {
          "size": "32px",
          "radius": "8px",
          "viewBg": "primary-bg",
          "viewColor": "primary",
          "deleteBg": "#FEF2F2",
          "deleteColor": "danger",
          "editBg": "#EFF6FF",
          "editColor": "#2563EB"
        }
      },
      "pagination": {
        "borderTop": "1px solid border",
        "padding": "14px 18px",
        "btnPadding": "6px 14px",
        "btnRadius": "8px",
        "activeBg": "primary",
        "activeColor": "#fff"
      },
      "notification": {
        "dropdownWidth": "340px",
        "dropdownRadius": "14px",
        "dropdownShadow": "0 8px 30px rgba(0,0,0,0.1)",
        "badgeSize": "18px",
        "badgeColor": "danger"
      },
      "toast": {
        "padding": "14px 22px",
        "radius": "10px",
        "fontSize": "14px",
        "successBg": "success",
        "errorBg": "danger",
        "shadow": "0 6px 20px rgba(0,0,0,0.12)"
      },
      "filterTab": {
        "padding": "8px 16px",
        "border": "1px solid border",
        "radius": "8px",
        "fontSize": "13px",
        "activeBg": "primary",
        "activeColor": "#fff"
      },
      "dashboardPanel": {
        "background": "surface",
        "border": "1px solid border",
        "borderRadius": "14px",
        "padding": "20px"
      },
      "sidebarFooterCard": {
        "background": "primary-bg",
        "borderRadius": "12px",
        "padding": "16px",
        "fontSize": "12px"
      }
    }
  },

  "sectionVariants": {
    "paper": { "background": "cream.50" },
    "cream": { "background": "cream.100" },
    "forest": { "background": "forest.900", "color": "cream.50" },
    "dark": { "background": "forest.950", "color": "cream.50" }
  },

  "animations": {
    "public": {
      "floatY": { "from": "translateY(0)", "to": "translateY(-18px)", "duration": "7s", "easing": "ease-in-out", "iteration": "infinite" },
      "pulseDot": { "from": "scale(1)", "mid": "scale(1.55) opacity(0.4)", "to": "scale(1) opacity(1)", "duration": "2.4s" },
      "rootLineDraw": { "property": "stroke-dashoffset", "from": "1000", "to": "0", "duration": "2s" },
      "rootLeafFade": { "from": "opacity(0) scale(0.6)", "to": "opacity(1) scale(1)", "delay": "1.4s", "duration": "0.5s" },
      "revealUp": { "from": "translateY(36px) opacity(0)", "to": "none opacity(1)" },
      "revealLeft": { "from": "translateX(-40px) opacity(0)", "to": "none opacity(1)" },
      "revealRight": { "from": "translateX(40px) opacity(0)", "to": "none opacity(1)" },
      "revealFade": { "from": "opacity(0)", "to": "opacity(1)" },
      "revealScale": { "from": "scale(0.92) opacity(0)", "to": "none opacity(1)" }
    },
    "admin": {
      "slideIn": { "from": "translateX(100%) opacity(0)", "to": "translateX(0) opacity(1)", "duration": "0.3s" },
      "dropIn": { "from": "translateY(-8px) opacity(0)", "to": "translateY(0) opacity(1)", "duration": "0.15s" }
    }
  },

  "assets": {
    "logo": {
      "header": "/assets/logo-source.png",
      "footer": "/assets/footer-logo-clean.png",
      "admin": "/assets/logo.png"
    },
    "images": {
      "hero": "/images/hero-girl-dog.jpg",
      "aboutPlant": "/images/about-plant.jpg",
      "aboutReal": "/images/about-real.jpg",
      "projects": {
        "tree": "/images/project-tree.jpg",
        "beachCleanup": "/images/project-beach-cleanup.jpg",
        "medicalCamp": "/images/project-medical-camp.jpg"
      },
      "reports": {
        "environment": "/images/report-environment-day-2026.jpg",
        "medical": "/images/report-medical-camp-2026.jpg"
      },
      "gallery": [
        "/images/gallery-01-saplings.jpg",
        "/images/gallery-02-beach-cleanup.jpg",
        "/images/gallery-03-pledge.jpg",
        "/images/gallery-04-medical-checkup.jpg",
        "/images/gallery-05-medical-camp.jpg",
        "/images/gallery-06-kids-play.jpg",
        "/images/gallery-07-group-beach.jpg",
        "/images/gallery-08-office.jpg"
      ]
    }
  }
}
