DATABASE_URL="postgresql://ergon:ergon123@localhost:5437/ergon_foundation"

# ─── JWT Secrets ───
# IMPORTANT: Generate strong random secrets for production!
#   Linux/macOS:  openssl rand -base64 32
#   PowerShell:   [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
JWT_ACCESS_SECRET="replace-with-random-64-char-base64-string"
JWT_REFRESH_SECRET="replace-with-another-random-64-char-base64-string"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ─── Server ───
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# ─── Admin ───
ADMIN_EMAIL="admin@ergonfoundation.org"
