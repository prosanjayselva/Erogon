generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  password        String
  name            String
  activeSessionId String?   @map("active_session_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  loginLogs     LoginLog[]

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Donor {
  id                Int      @id @default(autoincrement())
  name              String
  email             String
  phone             String
  amount            Float
  message           String?
  pan               String?  @map("pan")
  address           String?  @map("address")
  bankName          String?  @map("bank_name")
  transactionNumber String?  @map("transaction_number")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("donors")
}

model Event {
  id                 Int      @id @default(autoincrement())
  title              String
  description        String
  eventDate          DateTime @map("event_date")
  banner             String?
  status             String   @default("UPCOMING") // UPCOMING | COMPLETED | CANCELLED
  reminderDaysBefore Int?     @map("reminder_days_before")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("events")
}

model GalleryImage {
  id           Int      @id @default(autoincrement())
  activityName String   @map("activity_name")
  activityDate DateTime @map("activity_date")
  category     String
  caption      String?
  media        String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("gallery_images")
}

model GalleryVideo {
  id           Int      @id @default(autoincrement())
  activityName String   @map("activity_name")
  activityDate DateTime @map("activity_date")
  category     String
  caption      String?
  media        String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("gallery_videos")
}

model Notification {
  id          Int       @id @default(autoincrement())
  message     String
  type        String    // EVENT_REMINDER | ACTIVITY_LOG | CONTACT | VOLUNTEER | JOB_SEEKER | EMPLOYER | NEWSLETTER
  read        Boolean   @default(false)
  eventId     Int?      @map("event_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("notifications")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  action    String
  details   String?
  adminId   Int
  createdAt DateTime @default(now()) @map("created_at")

  @@map("activity_logs")
}

model Volunteer {
  id             Int      @id @default(autoincrement())
  fullName       String   @map("full_name")
  contactNumber  String   @map("contact_number")
  email          String
  city           String?
  areaOfInterest String?  @map("area_of_interest")
  availability   String?
  message        String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("volunteers")
}

model JobSeeker {
  id                Int      @id @default(autoincrement())
  fullName          String   @map("full_name")
  dob               String?
  gender            String?
  qualification     String?
  address           String?
  contactNumber     String   @map("contact_number")
  email             String
  experience        String?
  skills            String?
  preferredRole     String?  @map("preferred_role")
  preferredIndustry String?  @map("preferred_industry")
  preferredLocation String?  @map("preferred_location")
  currentCTC        String?  @map("current_ctc")
  expectedCTC       String?  @map("expected_ctc")
  noticePeriod      String?  @map("notice_period")
  languages         String?
  resume            String?
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("job_seekers")
}

model Employer {
  id              Int      @id @default(autoincrement())
  organization    String
  contactPerson   String   @map("contact_person")
  designation     String?
  contactNumber   String   @map("contact_number")
  email           String
  industryType    String?  @map("industry_type")
  jobRole         String?  @map("job_role")
  vacancies       Int?
  qualification   String?
  experience      String?
  salaryRange     String?  @map("salary_range")
  jobLocation     String?  @map("job_location")
  employmentType  String?  @map("employment_type")
  expectations    String?
  jd              String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("employers")
}

model Contact {
  id        Int      @id @default(autoincrement())
  fullName  String   @map("full_name")
  email     String
  phone     String?
  subject   String?
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contacts")
}

model Newsletter {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletters")
}

model LoginLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  ip        String?
  city      String?
  country   String?
  device    String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("login_logs")
}
